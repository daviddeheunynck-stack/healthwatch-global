# ─── Supabase ────────────────────────────────────────────────────────────────
# Public (exposed to browser) — safe to commit to vercel.json / CI env
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9...

# Server-only — bypasses RLS, never expose client-side
SUPABASE_SERVICE_ROLE_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9...

# ─── Stripe ──────────────────────────────────────────────────────────────────
# Use a restricted API key (rk_live_...) in production, not the full secret key
STRIPE_SECRET_KEY=rk_live_...
STRIPE_WEBHOOK_SECRET=whsec_...

# Pro plan price IDs (create in Stripe Dashboard → Products)
STRIPE_PRO_EUR_PRICE_ID=price_...
STRIPE_PRO_USD_PRICE_ID=price_...
STRIPE_PRO_EUR_ANNUAL_PRICE_ID=price_...
STRIPE_PRO_USD_ANNUAL_PRICE_ID=price_...

# Team plan price IDs — €149/month or €1,290/year (5 seats, institutional billing)
STRIPE_TEAM_EUR_PRICE_ID=price_...
STRIPE_TEAM_EUR_ANNUAL_PRICE_ID=price_...
STRIPE_TEAM_USD_PRICE_ID=price_...
STRIPE_TEAM_USD_ANNUAL_PRICE_ID=price_...

# ─── App URLs ─────────────────────────────────────────────────────────────────
# Full URL including https://, no trailing slash
NEXT_PUBLIC_BASE_URL=https://healthwatch-global.com
# Used for email link generation in regional alerts (can match NEXT_PUBLIC_BASE_URL)
NEXT_PUBLIC_APP_URL=https://healthwatch-global.com

# ─── Cron authentication ─────────────────────────────────────────────────────
# Secret passed as Bearer token by Vercel cron jobs — generate with: openssl rand -hex 32
CRON_SECRET=your-cron-secret-here

# ─── Email providers ─────────────────────────────────────────────────────────
# Brevo — used by weekly digest, watchlist/disease/regional alerts, onboarding
BREVO_API_KEY=xkeysib-...
# Resend — used by geofence alerts, PHEIC alerts, regional digest, country-risk alerts
RESEND_API_KEY=re_...

# ─── Web Push (VAPID) ────────────────────────────────────────────────────────
# Generate with: npx web-push generate-vapid-keys
NEXT_PUBLIC_VAPID_PUBLIC_KEY=BN...  # also set as VAPID_PUBLIC_KEY below
VAPID_PUBLIC_KEY=BN...
VAPID_PRIVATE_KEY=...
VAPID_SUBJECT=mailto:alerts@healthwatch-global.com

# ─── Optional / third-party ──────────────────────────────────────────────────
# Comma-separated list of admin email addresses
ADMIN_EMAILS=admin@example.com,other@example.com

# MyMemory translation API — add email for higher rate limits (1000 req/day vs 100)
MYMEMORY_EMAIL=your@email.com

# Sentry error tracking (build-time + runtime)
NEXT_PUBLIC_SENTRY_DSN=https://...@sentry.io/...
SENTRY_ORG=your-org
SENTRY_PROJECT=healthwatch-global
SENTRY_AUTH_TOKEN=sntrys_...

# Example API key shown in /docs (not a real credential — illustrative only)
HEALTHWATCH_API_KEY=hwg_...

# ─── LLM (optional) ──────────────────────────────────────────────────────────
# Used by admin geo-extraction (Claude Haiku). Falls back to regex if not set.
ANTHROPIC_API_KEY=sk-ant-...

# ─── Admin invite links ───────────────────────────────────────────────────────
# Base URL used in team invitation emails. Defaults to healthwatch-global.com.
NEXT_PUBLIC_SITE_URL=https://healthwatch-global.com
