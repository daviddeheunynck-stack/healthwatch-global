# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# next.js
/.next/
/out/

# production
/build

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files — exclude real credentials, but track the example
.env*
!.env.example

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts

.vercel
.env*.local
test-results/
playwright-report/
*.log

# Sentry Config File
.env.sentry-build-plugin

.env*.local

# Supabase CLI local state
supabase/.temp/

.vercel

# One-off prod data-fix scripts (fix-*/check-*/scan-*/add-*/update-*/backfill-*
# ending in a YYYY-MM-DD date). These are throwaway tools for a single prod data
# correction, not product code — deleted once the fix is confirmed applied
# (see feedback_oneoff_scripts_cleanup memory). Ignored so a broad `git add -A`
# from an interactive session can't re-track one before it's cleaned up, the
# way it did on 2026-08-01 (commit 735fe46 re-added two already-deleted ones).
scripts/*-20[0-9][0-9]-[0-9][0-9]-[0-9][0-9].mjs

# One-off check script, no date suffix so it doesn't match the pattern above —
# ignored explicitly instead of renaming it (flagged in the 2026-08-23 security
# audit as untracked-but-not-ignored, so a broad `git add -A` would catch it).
scripts/check-prospect-conversions.mjs

.vercel

# Copie de travail des routines Claude Desktop (~/.claude/scheduled-tasks),
# posee ici le temps d'un audit parce que le dossier d'origine est une zone
# protegee que le pont de fichiers ne peut pas lire. Ce sont des prompts de
# prospection et de suivi client : ils n'ont rien a faire dans un depot avec
# un remote. Ignore pour la meme raison que les scripts one-off ci-dessus —
# qu'un `git add -A` depuis une session interactive ne puisse pas les tracker.
# A supprimer une fois l audit termine.
_routines-audit/
